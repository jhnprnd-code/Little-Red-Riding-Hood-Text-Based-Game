{
  "name": "little-red-riding-hood-text-based-game",
  "version": "1.0.0",
  "private": true,
  "description": "Text-based Little Red Riding Hood adventure with an Express API and Prolog-style intent parsing.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7",
    "tau-prolog": "^0.3.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.7"
  }
}
